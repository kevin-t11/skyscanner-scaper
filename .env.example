# Proxy URL. `{session}` is replaced with a random id per browser so each worker keeps one sticky IP.
# Evomi Core Residential example (append targeting options to the password):
PROXY_URL=http://USERNAME:PASSWORD_country-US_session-{session}_lifetime-30@rp.evomi.com:1000

PORT=8000
POOL_SIZE=2                       # browsers (one IP each)
CHROME_PATH=                      # default: google-chrome on PATH
SKYSCANNER_HOST=www.skyscanner.com
MARKET=US
LOCALE=en-US
CURRENCY=USD
SEARCH_DEADLINE_MS=12000
HEADLESS=false                    # PerimeterX rejects headless Chrome; run under Xvfb (see README)
HOST=127.0.0.1                    # use 0.0.0.0 to expose it; set API_KEY when you do
API_KEY=                          # optional: require `x-api-key` on /url
OUTPUT_DIR=output                 # every /url response saved here as JSON; empty disables
LOG_LEVEL=info                    # debug | info | warn | error
