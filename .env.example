# Residential proxy; `{session}` gets a new id per browser so each one keeps a sticky IP.
# Leave empty to use your own connection. Evomi example (either form works):
# PROXY_URL=core-residential.evomi.com:1000:USERNAME:PASSWORD_country-IN_session-{session}_lifetime-30
# PROXY_URL=http://USERNAME:PASSWORD_country-IN_session-{session}_lifetime-30@core-residential.evomi.com:1000
PROXY_URL=

PORT=8000
POOL_SIZE=1          # browsers in the pool (one proxy IP and ~300-700 MB RAM each)
API_KEY=             # optional: require the `x-api-key` header on /url
LOGGING=enabled      # enabled | disabled
STOP_WHEN_STABLE=enabled   # return once 2 polls in a row add no flights (faster); disabled = wait for Skyscanner's `complete`
# CHROME_PATH=       # optional: found automatically on macOS and Linux
