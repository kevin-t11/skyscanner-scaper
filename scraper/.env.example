# Residential proxy; `{session}` gets a new id per browser so each one keeps a sticky IP.
# Leave empty to use your own connection. Evomi example (either form works):
# PROXY_URL=core-residential.evomi.com:1000:USERNAME:PASSWORD_country-IN_session-{session}_lifetime-30
# PROXY_URL=http://USERNAME:PASSWORD_country-IN_session-{session}_lifetime-30@core-residential.evomi.com:1000
# Numbered fixed-IP list (e.g. Webshare): `{slot}` becomes 1…PROXY_SLOTS, one free IP per browser
# PROXY_URL=http://USERNAME-{slot}:PASSWORD@p.webshare.io:80
PROXY_URL=
# PROXY_SLOTS=100          # IPs behind {slot}
# FALLBACK_PROXY_URL=      # used while every slot IP is busy or resting 30 min after a block (e.g. the residential PROXY_URL above)
# PROXY_ROTATE_AFTER=0     # searches before a slot/fallback browser moves to the next free IP; 0 = never

PORT=8000
POOL_SIZE=1          # browsers in the pool (one proxy IP and ~300-700 MB RAM each)
API_KEY=             # optional: require the `x-api-key` header on /url
LOGGING=enabled      # enabled | disabled
STOP_WHEN_STABLE=disabled  # disabled = wait for Skyscanner's `complete` (full results); enabled = return after the first poll that adds no flights (faster, may miss flights)
SEARCH_DEADLINE_MS=30000   # cap for one search; partial results are returned after it
# CHROME_PATH=       # optional: found automatically on macOS and Linux
